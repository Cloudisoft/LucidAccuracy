---
import '@fontsource-variable/inter';
import '@fontsource-variable/schibsted-grotesk';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, locations, markets } from '../data/site';

interface Props {
  title: string;
  description: string;
  og?: string;
  schema?: Record<string, unknown>[];
  crumbs?: { name: string; href: string }[];
  noindex?: boolean;
}

const { title, description, og = 'home', schema = [], crumbs = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(`/og/${og}.jpg`, site.url).href;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site.url}/#organization`,
  name: site.name,
  url: site.url,
  logo: `${site.url}/icon-512.png`,
  image: `${site.url}/og/home.jpg`,
  description: site.positioning,
  slogan: site.tagline,
  email: site.email,
  telephone: site.phone,
  areaServed: markets.map((m) => ({ '@type': m.code === 'eu' ? 'Place' : 'Country', name: m.name })),
  address: locations.map((l) => ({
    '@type': 'PostalAddress',
    streetAddress: l.street,
    addressLocality: l.locality,
    addressRegion: l.region,
    postalCode: l.postal,
    addressCountry: 'US',
  })),
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    telephone: site.phone,
    email: site.email,
    availableLanguage: 'English',
  },
  knowsAbout: [
    'Recruitment and workforce solutions',
    'Technology solutions',
    'AI calling agents',
    'Business process solutions',
    'Corporate training',
    'Business consulting',
  ],
  ...(site.social.length ? { sameAs: site.social.map((s) => s.url) } : {}),
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  url: site.url,
  name: site.name,
  description: site.description,
  publisher: { '@id': `${site.url}/#organization` },
  inLanguage: 'en',
};

const breadcrumb = crumbs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [{ name: 'Home', href: '/' }, ...crumbs].map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.name,
        item: new URL(c.href, site.url).href,
      })),
    }
  : null;

const graphs = [organization, website, ...(breadcrumb ? [breadcrumb] : []), ...schema];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="author" content="LucidAccuracy" />
    <meta name="theme-color" content="#0b1a1c" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content="LucidAccuracy" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {graphs.map((g) => <script type="application/ld+json" is:inline set:html={JSON.stringify(g)} />)}

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <ClientRouter />
  </head>
  <body>
    <div class="progress" data-progress aria-hidden="true"></div>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
