---
import '@fontsource-variable/inter';
import '@fontsource-variable/schibsted-grotesk';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, locations, markets, solutions, agent } from '../data/site';

interface Props {
  title: string;
  description: string;
  og?: string;
  schema?: Record<string, unknown>[];
  crumbs?: { name: string; href: string }[];
  noindex?: boolean;
}

const { title, description, og = 'home', schema = [], crumbs = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(`/og/${og}.jpg`, site.url).href;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site.url}/#organization`,
  name: site.name,
  alternateName: ['Lucid Accuracy'],
  url: site.url,
  logo: `${site.url}/icon-512.png`,
  image: `${site.url}/og/home.jpg`,
  description: site.positioning,
  slogan: site.tagline,
  email: site.email,
  telephone: site.phone,
  areaServed: markets.map((m) => ({ '@type': m.code === 'eu' ? 'Place' : 'Country', name: m.name })),
  address: locations.map((l) => ({
    '@type': 'PostalAddress',
    streetAddress: l.street,
    addressLocality: l.locality,
    addressRegion: l.region,
    postalCode: l.postal,
    addressCountry: 'US',
  })),
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    telephone: site.phone,
    email: site.email,
    availableLanguage: 'English',
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'LucidAccuracy solutions',
    itemListElement: [
      ...solutions.map((x) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: x.title, url: `${site.url}/solutions/${x.slug}/`, description: x.summary } })),
      { '@type': 'Offer', itemOffered: { '@type': 'SoftwareApplication', name: agent.name, url: `${site.url}/ai-calling-agent/`, applicationCategory: 'BusinessApplication' } },
    ],
  },
  knowsAbout: [
    'Recruitment and workforce solutions',
    'Technology solutions',
    'AI calling agents',
    'Business process solutions',
    'Corporate training',
    'Business consulting',
  ],
  ...(site.social.length ? { sameAs: site.social.map((s) => s.url) } : {}),
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  url: site.url,
  name: site.name,
  alternateName: ['Lucid Accuracy'],
  description: site.description,
  publisher: { '@id': `${site.url}/#organization` },
  inLanguage: 'en',
};

const breadcrumb = crumbs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [{ name: 'Home', href: '/' }, ...crumbs].map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.name,
        item: new URL(c.href, site.url).href,
      })),
    }
  : null;

const webpage = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: title,
  description,
  isPartOf: { '@id': `${site.url}/#website` },
  about: { '@id': `${site.url}/#organization` },
  primaryImageOfPage: ogImage,
  inLanguage: 'en',
  dateModified: new Date().toISOString().slice(0, 10),
};

const graphs = [organization, website, webpage, ...(breadcrumb ? [breadcrumb] : []), ...schema];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="author" content="LucidAccuracy" />
    <meta name="application-name" content="LucidAccuracy" />
    <meta name="apple-mobile-web-app-title" content="LucidAccuracy" />
    <meta name="theme-color" content="#0b1a1c" />
    <meta name="color-scheme" content="light dark" />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content="LucidAccuracy" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {graphs.map((g) => <script type="application/ld+json" is:inline set:html={JSON.stringify(g)} />)}

    <script is:inline>
      (() => {
        const apply = () => {
          let theme = null;
          try {
            theme = localStorage.getItem('theme');
          } catch (e) {}
          if (theme !== 'dark' && theme !== 'light') {
            theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.dataset.theme = theme;
          document.documentElement.classList.add('js');
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <div class="progress" data-progress aria-hidden="true"></div>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <div class="toast" data-toast role="status" aria-live="polite" hidden>
      <span class="toast__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
      </span>
      <span class="toast__body"><strong data-toast-title></strong><span data-toast-text></span></span>
      <button class="toast__close" data-toast-close aria-label="Dismiss notification">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg>
      </button>
      <i class="toast__timer" aria-hidden="true"></i>
    </div>
    <button class="to-top" data-to-top aria-label="Back to top">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 7-7 7 7"></path><path d="M12 19V5"></path></svg>
    </button>
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
