---
const { class: cls = '' } = Astro.props;
---

<span class:list={['logo', cls]}>
  <span class="logo__word">Lucid<b>Accuracy</b></span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.375rem;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .logo__word b {
    font-weight: 700;
    color: var(--logo-accent, var(--teal));
  }
</style>
