---
const { class: cls = '' } = Astro.props;
---

<span class:list={['logo', cls]}>
  <svg class="logo__mark" viewBox="0 0 64 64" width="30" height="30" aria-hidden="true">
    <rect width="64" height="64" rx="16" fill="hsl(168 65% 34%)"></rect>
    <path d="M45.4 21.6A17 17 0 1 0 49 32" fill="none" stroke="#fff" stroke-width="5.5" stroke-linecap="round"></path>
    <circle cx="32" cy="32" r="5.5" fill="hsl(38 85% 52%)"></circle>
  </svg>
  <span class="logo__word">Lucid<b>Accuracy</b></span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .logo__mark {
    flex: none;
    border-radius: 8px;
  }
  .logo__word b {
    font-weight: 700;
    color: var(--logo-accent, var(--teal));
  }
</style>
