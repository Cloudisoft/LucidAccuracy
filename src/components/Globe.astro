---
import { markets, locations } from '../data/site';
const sides: Record<string, string> = { gb: 'left', ca: 'left', eu: 'right' };
const m = markets.map(({ name, lat, lon, code }) => ({ name, lat, lon, side: sides[code] }));
const o = locations.map(({ lat, lon }) => ({ lat, lon }));
---

<div class="globe">
  <canvas
    data-globe
    data-markets={JSON.stringify(m)}
    data-offices={JSON.stringify(o)}
    tabindex="0"
    role="img"
    aria-label="Rotating globe showing the markets LucidAccuracy serves: United States, Canada, United Kingdom, Europe, India and Australia. Use the left and right arrow keys to rotate."
  ></canvas>
</div>

<style>
  .globe {
    position: relative;
    aspect-ratio: 1;
    width: 100%;
  }
  canvas {
    width: 100%;
    height: 100%;
    cursor: grab;
    touch-action: pan-y;
    opacity: 0;
    transform: scale(0.94);
    transition:
      opacity 1.4s var(--ease),
      transform 1.8s var(--ease);
  }
  canvas:active {
    cursor: grabbing;
  }
  canvas:global(.is-ready) {
    opacity: 1;
    transform: none;
  }
</style>
