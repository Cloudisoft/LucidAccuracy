---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import ContactForm from '../components/ContactForm.astro';
import { site, locations, markets, solutions } from '../data/site';
const crumbs = [{ name: 'Contact', href: '/contact/' }];
---

<Base
  title="Contact LucidAccuracy | Talk to Our Team"
  description="Contact LucidAccuracy about workforce, technology, AI Calling Agent demos, training, consulting or business process solutions. Call +1 307-999-9564 or send a message."
  og="contact"
  {crumbs}
  schema={[{ '@context': 'https://schema.org', '@type': 'ContactPage', url: `${site.url}/contact/`, about: { '@id': `${site.url}/#organization` } }]}
>
  <PageHero
    title="Talk to the LucidAccuracy team"
    lead="Tell us what you need to hire, build or automate. Someone from our team will contact you within 24–48 hours."
    {crumbs}
  />

  <section class="section">
    <div class="wrap contact">
      <div class="form-col"><ContactForm /></div>

      <aside class="direct">
        <h2>Contact us directly</h2>
        <ul class="direct__list">
          <li>
            <span class="icon-tile"><Icon name="Phone" /></span>
            <div>
              <span>Phone</span>
              <a href={site.phoneHref}>{site.phone}</a>
            </div>
          </li>
          <li>
            <span class="icon-tile"><Icon name="Mail" /></span>
            <div>
              <span>Email</span>
              <a href={`mailto:${site.email}`}>{site.email}</a>
            </div>
          </li>
        </ul>

        <h2 class="direct__h">U.S. offices</h2>
        <ul class="direct__offices">
          {
            locations.map((l) => (
              <li>
                <strong>{l.state}</strong>
                <address>{l.lines.map((line) => <span>{line}</span>)}</address>
              </li>
            ))
          }
        </ul>
        <a href="/global-presence/" class="arrow-link">See markets and locations <Icon name="ArrowRight" /></a>
      </aside>
    </div>
  </section>
</Base>

<style>
  .contact {
    display: grid;
    gap: 56px 80px;
  }
  .direct h2 {
    font-size: 1.75rem;
    margin-bottom: 28px;
  }
  .direct__list {
    display: grid;
    gap: 18px;
  }
  .direct__list li {
    display: flex;
    gap: 16px;
    align-items: center;
  }
  .direct__list div span {
    display: block;
    font-size: 0.875rem;
    color: var(--ink-2);
  }
  .direct__list a {
    display: inline-block;
    padding-block: 8px;
    font-family: var(--font-display);
    font-size: 1.3125rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .direct__list a:hover {
    color: var(--teal-deep);
  }
  .direct__h {
    margin-top: 48px;
  }
  .direct__offices {
    display: grid;
    gap: 20px;
    margin-bottom: 16px;
  }
  .direct__offices strong {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
  }
  .direct address {
    font-style: normal;
    color: var(--ink-2);
  }
  .direct address span {
    display: block;
  }
  @media (min-width: 1000px) {
    .contact {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
    }
  }
</style>
