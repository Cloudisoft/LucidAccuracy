---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Page Not Found | LucidAccuracy" description="The page you were looking for could not be found." og="default" noindex>
  <PageHero title="This page could not be found" lead="The address may have changed when we rebuilt the website. These links will get you back on track.">
    <a href="/" class="btn btn--amber">Go to the Homepage <Icon name="ArrowRight" /></a>
    <a href="/solutions/" class="btn btn--ghost">See Our Solutions</a>
    <a href="/contact/" class="btn btn--ghost">Contact the Team</a>
  </PageHero>
</Base>
