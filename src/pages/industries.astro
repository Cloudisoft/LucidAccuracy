---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Cta from '../components/Cta.astro';
import { industries } from '../data/site';
import photos from '../data/photos.json';
const pics = photos as Record<string, { src: string; placeholder: string }>;
const crumbs = [{ name: 'Industries', href: '/industries/' }];
---

<Base
  title="Industries We Serve | LucidAccuracy"
  description="LucidAccuracy serves technology, healthcare, engineering, finance, life sciences, manufacturing, logistics, telecommunications, retail, energy and professional services."
  og="industries"
  {crumbs}
>
  <PageHero
    title="Eleven industries, one partner"
    lead="LucidAccuracy supplies talent, technology and operations support across the sectors below. Each engagement is led by people who know the roles and the regulations involved."
    {crumbs}
  >
    <a href="/contact/" class="btn btn--amber">Talk to Our Team <Icon name="ArrowRight" /></a>
  </PageHero>

  <section class="section">
    <div class="wrap">
      <ul class="ind">
        {
          industries.map((ind, i) => (
            <li id={ind.slug} class:list={[{ 'ind--flip': i % 2 === 1 }]}>
              <figure class="ind__media" data-reveal="open">
                {pics[ind.slug] ? (
                  <img
                    src={pics[ind.slug].src}
                    alt=""
                    width="960"
                    height="640"
                    loading={i < 2 ? 'eager' : 'lazy'}
                    decoding="async"
                    style={`background-image:url(${pics[ind.slug].placeholder})`}
                  />
                ) : (
                  <span class="ind__art">
                    <Icon name={ind.icon} size={88} stroke-width={1} />
                  </span>
                )}
                <span class="ind__badge"><Icon name={ind.icon} size={22} /></span>
              </figure>
              <div class="ind__main" data-reveal={i % 2 ? 'left' : 'right'}>
                <h2>{ind.name}</h2>
                <p>{ind.text}</p>
                <ul class="chips">
                  {ind.roles.map((r) => <li class="chip">{r}</li>)}
                </ul>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--sand">
    <div class="wrap">
      <div class="head head--split">
        <h2 data-reveal="mask">What we deliver in every industry</h2>
        <p data-reveal style="--i:1">The same three businesses, adapted to the sector.</p>
      </div>
      <ul class="panels">
        <li data-reveal="open">
          <a class="panel" href="/solutions/recruitment-workforce/">
            <span class="icon-tile"><Icon name="Users" /></span>
            <h3>Recruitment & Workforce</h3>
            <p>Permanent, contract and flexible hiring for specialist and volume roles.</p>
          </a>
        </li>
        <li data-reveal="open" style="--i:1">
          <a class="panel" href="/solutions/technology/">
            <span class="icon-tile"><Icon name="Code" /></span>
            <h3>Technology Solutions</h3>
            <p>Software, cloud, data and security projects built for the sector's systems.</p>
          </a>
        </li>
        <li data-reveal="open" style="--i:2">
          <a class="panel" href="/ai-calling-agent/">
            <span class="icon-tile"><Icon name="AudioLines" /></span>
            <h3>LucidAI Calling Agent</h3>
            <p>Automated phone conversations for scheduling, screening and follow-ups.</p>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <Cta title="Hiring or building in your industry?" />
</Base>

<style>
  .ind {
    border-top: 1px solid var(--line);
  }
  .ind > li {
    display: grid;
    gap: 28px 64px;
    align-items: center;
    padding: clamp(32px, 4vw, 56px) 0;
    border-bottom: 1px solid var(--line);
    scroll-margin-top: calc(var(--header-h) + 8px);
  }
  .ind__media {
    position: relative;
    aspect-ratio: 3 / 2;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--night);
  }
  .ind__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background-size: cover;
    transition: transform 1.2s var(--ease);
  }
  .ind > li:hover .ind__media img {
    transform: scale(1.04);
  }
  .ind__art {
    display: grid;
    place-items: center;
    height: 100%;
    color: var(--teal-bright);
    background:
      radial-gradient(circle at 30% 30%, hsl(168 65% 34% / 0.5), transparent 60%),
      var(--night);
  }
  .ind__badge {
    position: absolute;
    left: 18px;
    bottom: 18px;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: var(--glass);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: var(--teal-deep);
  }
  .ind > li:target .ind__media {
    box-shadow: 0 0 0 3px var(--amber);
  }
  .ind h2 {
    font-size: clamp(1.625rem, 2.6vw, 2.25rem);
    margin-bottom: 12px;
  }
  .ind__main p {
    color: var(--ink-2);
    max-width: 52ch;
    margin-bottom: 20px;
  }
  @media (min-width: 900px) {
    .ind > li {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .ind--flip .ind__media {
      order: 2;
    }
  }
</style>
