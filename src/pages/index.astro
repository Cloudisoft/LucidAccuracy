---
import CareerField from '../components/CareerField.astro';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Globe from '../components/Globe.astro';
import WorldMap from '../components/WorldMap.astro';
import CallDemo from '../components/CallDemo.astro';
import Cta from '../components/Cta.astro';
import photos from '../data/photos.json';
import { site, pillars, solutions, industries, techCapabilities, whyUs, projects, agent, locations, markets } from '../data/site';

const support = solutions.filter((s) => ['training', 'consulting', 'business-process'].includes(s.slug));
const featured = [projects[0], projects[2], projects[1]];
const marquee = [
  'Permanent Recruitment',
  'Software Development',
  'AI Calling Agent',
  'Contract Staffing',
  'Cloud Solutions',
  'Corporate Training',
  'Data & Analytics',
  'Workforce Consulting',
  'Cybersecurity',
  'Back-office Operations',
];
const hub = techCapabilities.map((t, i) => {
  const a = (i / techCapabilities.length) * Math.PI * 2 - Math.PI / 2;
  return { ...t, x: 50 + Math.cos(a) * 39, y: 50 + Math.sin(a) * 39 };
});
const orbit = [
  { label: 'Recruitment', icon: 'Users', x: 2, y: 48 },
  { label: 'AI Calling Agent', icon: 'AudioLines', x: 48, y: 8 },
  { label: 'Cloud & Data', icon: 'Cloud', x: 12, y: 76 },
  { label: 'Training', icon: 'GraduationCap', x: 54, y: 72 },
  { label: 'Business Process', icon: 'Workflow', x: 40, y: 90 },
];
const shortlist = [
  ['Cloud Engineer', 'Toronto', 'Shortlisted'],
  ['Clinical Coordinator', 'Manchester', 'Interview'],
  ['Financial Analyst', 'Sydney', 'Screened'],
  ['Process Engineer', 'Pune', 'Sourced'],
];
---

<Base title="LucidAccuracy | Global Workforce, Technology & Business Solutions" description={site.description} og="home">
  <!-- 1. Hero -->
  <section class="hero on-night has-net">
    <CareerField />
    <div class="wrap hero__in">
      <div class="hero__copy">
        <p class="hero__line fade-up">Global Workforce <i>•</i> Technology <i>•</i> AI <i>•</i> Business Solutions</p>
        <h1 class="lines">
          <span class="line" style="--i:1"><span>Building Global Talent.</span></span>
          <span class="line" style="--i:2"><span>Powering Technology.</span></span>
          <span class="line" style="--i:3"><span>Driving Business <em>Forward.</em></span></span>
        </h1>
        <p class="hero__sub fade-up" style="--i:5">
          LucidAccuracy partners with organizations across the United States, Canada, United Kingdom, Australia, Europe and India
          to deliver workforce, technology, AI, consulting, training and business solutions.
        </p>
        <div class="actions fade-up" style="--i:6">
          <a href="#solutions" class="btn btn--amber">Explore Our Solutions <Icon name="ArrowDown" /></a>
          <a href="/contact/" class="btn btn--ghost">Talk to Our Team</a>
        </div>
      </div>
      <div class="hero__globe">
        <Globe />
        <ul class="orbit" aria-hidden="true">
          {orbit.map((o, i) => (
            <li class="orbit__chip" style={`--x:${o.x}%;--y:${o.y}%;--i:${i}`}>
              <span class="orbit__icon"><Icon name={o.icon} size={16} /></span>
              {o.label}
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="marquee" aria-hidden="true">
      <div class="marquee__track">
        {[...marquee, ...marquee].map((m) => <span>{m}</span>)}
      </div>
    </div>
  </section>

  <!-- 2. Global introduction -->
  <section class="section intro">
    <div class="wrap intro__in">
      <h2 class="intro__statement" data-reveal="left">
        A global workforce, technology and AI solutions company helping organizations{' '}
        <span>build teams, adopt technology and automate business operations.</span>
      </h2>
      <div class="intro__side" data-reveal="right" style="--i:2">
        <p>
          Clients come to LucidAccuracy to hire people, to deliver technology projects and to put AI to work on routine
          conversations. One team covers all three, with training, consulting and business process support alongside.
        </p>
        <dl class="facts">
          <div><dt data-count={markets.length}>{markets.length}</dt><dd>markets served</dd></div>
          <div><dt data-count={solutions.length + 1}>{solutions.length + 1}</dt><dd>solution lines</dd></div>
          <div><dt data-count={industries.length}>{industries.length}</dt><dd>industries</dd></div>
          <div><dt data-count={locations.length}>{locations.length}</dt><dd>U.S. offices</dd></div>
        </dl>
        <a href="/about/" class="arrow-link">Read about the company <Icon name="ArrowRight" /></a>
      </div>
    </div>
  </section>

  <!-- 3. Core solutions -->
  <section class="section section--sand solutions" id="solutions">
    <div class="wrap">
      <div class="head head--split">
        <h2 data-reveal="mask">People, technology and AI from one company</h2>
        <p data-reveal style="--i:1">
          Three core businesses, each with its own specialists, supported by training, consulting and business process teams.
        </p>
      </div>

      <div class="pillars" data-switch data-reveal>
        {
          pillars.map((p, i) => (
            <article class:list={['pillar', `pillar--${p.key}`, { 'is-active': i === 0 }]} data-switch-to={p.key}>
              <header class="pillar__head">
                <p class="pillar__label">{p.label}</p>
                <h3>{p.title}</h3>
              </header>
              <div class="pillar__more">
                <div class="pillar__text">
                  <p>{p.text}</p>
                  <ul>
                    {p.points.map((pt) => (
                      <li>
                        <Icon name="Check" size={16} /> {pt}
                      </li>
                    ))}
                  </ul>
                  <a href={p.href} class="arrow-link">
                    {p.cta} <Icon name="ArrowRight" />
                  </a>
                </div>

                <div class="pillar__visual" aria-hidden="true">
                  {p.key === 'people' && (
                    <ul class="v-list">
                      {shortlist.map(([role, city, stage], n) => (
                        <li style={`--n:${n}`}>
                          <span>
                            <b>{role}</b>
                            {city}
                          </span>
                          <em>{stage}</em>
                        </li>
                      ))}
                    </ul>
                  )}
                  {p.key === 'technology' && (
                    <div class="v-pipe">
                      <ol>
                        {['Design', 'Build', 'Test', 'Release'].map((s, n) => (
                          <li style={`--n:${n}`}>{s}</li>
                        ))}
                      </ol>
                      <pre>{`$ release web-platform\n  build    passed\n  tests    passed\n  deploy   live`}</pre>
                    </div>
                  )}
                  {p.key === 'ai' && (
                    <div class="v-call">
                      <div class="v-call__wave">
                        {Array.from({ length: 22 }, (_, n) => (
                          <i style={`--d:${(0.6 + ((n * 37) % 9) / 12).toFixed(2)}s;--o:${(((n * 53) % 13) / -10).toFixed(2)}s`} />
                        ))}
                      </div>
                      <p>
                        <b>Inbound call answered</b>
                        Lead qualified, appointment booked
                      </p>
                    </div>
                  )}
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <ul class="support">
        {
          support.map((s, i) => (
            <li data-reveal="open" style={`--i:${i}`}>
              <a href={`/solutions/${s.slug}/`}>
                <span class="icon-tile">
                  <Icon name={s.icon} />
                </span>
                <span>
                  <strong>{s.title}</strong>
                  <span>{s.lead}</span>
                </span>
                <Icon name="ArrowUpRight" class="support__arrow" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 4. AI Calling Agent -->
  <section class="section section--night agent has-net">
    <CareerField />
    <div class="agent__glow" aria-hidden="true"></div>
    <div class="wrap agent__in">
      <div class="agent__copy">
        <p class="agent__tag" data-reveal><Icon name="AudioLines" size={18} /> {agent.name}</p>
        <h2 data-reveal="mask" style="--i:1">{agent.hero}</h2>
        <p class="agent__sub" data-reveal style="--i:2">{agent.sub}</p>
        <p class="agent__text" data-reveal style="--i:3">
          The agent answers and places phone calls for your business. It talks with customers, qualifies leads, schedules
          appointments and follows up with prospects, 24 hours a day.
        </p>
        <ul class="chips" data-reveal style="--i:4">
          {agent.capabilities.slice(0, 5).map((c) => <li class="chip">{c.name}</li>)}
        </ul>
        <div class="actions" data-reveal style="--i:5">
          <a href="/ai-calling-agent/" class="btn btn--amber">Explore AI Calling Agent <Icon name="ArrowRight" /></a>
          <a href="/contact/?topic=AI%20Calling%20Agent%20demo" class="btn btn--ghost">Book a Demo</a>
        </div>
      </div>
      <div class="agent__demo" data-reveal="scale">
        <CallDemo />
      </div>
    </div>
  </section>

  <!-- 5. Industries -->
  <section class="section industries">
    <div class="wrap">
      <div class="head head--split">
        <h2 data-reveal="mask">Industries we serve</h2>
        <p data-reveal style="--i:1">
          LucidAccuracy works well beyond technology hiring. Our teams support {industries.length} industries with talent,
          technology and operations.
        </p>
      </div>
      <div class="index" data-switch>
        <ul class="index__list">
          {
            industries.map((ind, i) => (
              <li>
                <a href={`/industries/#${ind.slug}`} class:list={['index__item', { 'is-active': i === 0 }]} data-switch-to={ind.slug}>
                  <span>{ind.name}</span>
                  <Icon name="ArrowRight" size={20} />
                </a>
              </li>
            ))
          }
        </ul>
        <div class="index__stage">
          {
            industries.map((ind, i) => (
              <div class:list={['index__panel', { 'is-active': i === 0 }]} data-switch-panel={ind.slug}>
                {(photos as Record<string, { src: string; placeholder: string }>)[ind.slug] && (
                  <img
                    class="index__photo"
                    src={(photos as Record<string, { src: string }>)[ind.slug].src}
                    alt=""
                    width="960"
                    height="640"
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <span class="index__icon">
                  <Icon name={ind.icon} size={44} stroke-width={1.3} />
                </span>
                <h3>{ind.name}</h3>
                <p>{ind.text}</p>
                <ul class="chips">
                  {ind.roles.map((r) => <li class="chip">{r}</li>)}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Technology & AI capabilities -->
  <section class="section section--sand tech has-net">
    <CareerField tone="light" density={0.8} />
    <div class="wrap tech__in">
      <div>
        <div class="head">
          <h2 data-reveal="mask">Technology and AI capabilities</h2>
          <p data-reveal style="--i:1">
            Our engineers design, build and run systems for clients. This is project delivery, separate from technology
            staffing.
          </p>
        </div>
        <ul class="rows tech__rows">
          {
            techCapabilities.map((t, i) => (
              <li data-reveal style={`--i:${i % 4}`}>
                <h3>{t.name}</h3>
                <p>{t.text}</p>
              </li>
            ))
          }
        </ul>
        <a href="/technology-ai/" class="arrow-link tech__link">See technology and AI services <Icon name="ArrowRight" /></a>
      </div>

      <div class="hub" aria-hidden="true" data-reveal="scale">
        <svg viewBox="0 0 100 100">
          <circle cx="50" cy="50" r="39" class="hub__ring"></circle>
          <circle cx="50" cy="50" r="22" class="hub__ring hub__ring--in"></circle>
          {hub.map((n, i) => <line x1="50" y1="50" x2={n.x} y2={n.y} class="hub__line" style={`--i:${i}`} />)}
        </svg>
        <span class="hub__core">
          <svg viewBox="0 0 64 64" width="44" height="44">
            <path d="M45.4 21.6A17 17 0 1 0 49 32" fill="none" stroke="#fff" stroke-width="5.5" stroke-linecap="round"></path>
            <circle cx="32" cy="32" r="5.5" fill="hsl(38 85% 52%)"></circle>
          </svg>
        </span>
        {
          hub.map((n, i) => (
            <span class="hub__node" style={`left:${n.x}%;top:${n.y}%;--i:${i}`}>
              <Icon name={n.icon} size={18} /> {n.short}
            </span>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 7. Selected projects -->
  <section class="section work">
    <div class="wrap">
      <div class="head head--split">
        <h2 data-reveal="mask">Selected projects</h2>
        <p data-reveal style="--i:1">Examples of the work our workforce, technology and AI teams deliver for clients.</p>
      </div>
      <ul class="work__grid">
        {
          featured.map((p, i) => (
            <li data-reveal="open" style={`--i:${i}`}>
              <a href={`/projects/#${p.slug}`} class="case">
                <span class="case__meta">
                  <span>{p.pillar}</span>
                  <span>{p.market}</span>
                </span>
                <h3>{p.title}</h3>
                <p>{p.challenge}</p>
                <span class="case__foot">
                  {p.industry} <Icon name="ArrowUpRight" size={20} />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <a href="/projects/" class="arrow-link work__all">See all projects <Icon name="ArrowRight" /></a>
    </div>
  </section>

  <!-- 8. Global presence -->
  <section class="section section--sand presence">
    <div class="wrap">
      <div class="head head--split">
        <h2 data-reveal="mask">Global Reach. Local Expertise.</h2>
        <p data-reveal style="--i:1">
          LucidAccuracy supports organizations and professionals across major international markets, combining global
          capabilities with an understanding of regional workforce and business requirements.
        </p>
      </div>
      <WorldMap />
      <a href="/global-presence/" class="arrow-link presence__link">See markets and office locations <Icon name="ArrowRight" /></a>
    </div>
  </section>

  <!-- 9. Why LucidAccuracy -->
  <section class="section why">
    <div class="wrap why__in">
      <div class="why__head">
        <h2 data-reveal="mask">Why organizations choose LucidAccuracy</h2>
        <p class="lead" data-reveal style="--i:1">
          One accountable partner for talent, technology and operations, in the markets where you work.
        </p>
      </div>
      <ol class="why__list">
        {
          whyUs.map((w, i) => (
            <li data-reveal style={`--i:${i % 3}`}>
              <h3>{w.name}</h3>
              <p>{w.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <Cta />
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    background:
      radial-gradient(80% 70% at 78% 46%, hsl(168 65% 30% / 0.3), transparent 70%),
      radial-gradient(50% 50% at 0% 100%, hsl(38 85% 52% / 0.09), transparent 70%), var(--night);
    color: var(--on-night);
    overflow: hidden;
  }
  .hero__in {
    flex: 1;
    display: grid;
    align-items: center;
    gap: 16px 32px;
    padding-top: calc(var(--header-h) + 40px);
    padding-bottom: 40px;
  }
  .hero__line {
    margin-bottom: 26px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--teal-bright);
  }
  .hero__line i {
    font-style: normal;
    color: var(--amber);
    margin-inline: 0.35em;
  }
  .hero h1 {
    font-size: clamp(2.125rem, 4.15vw, 3.875rem);
    letter-spacing: -0.034em;
  }
  .hero h1 em {
    font-style: normal;
    color: var(--amber);
  }
  .hero__sub {
    margin: 28px 0 34px;
    max-width: 54ch;
    font-size: clamp(1.0625rem, 1.35vw, 1.25rem);
    line-height: 1.55;
    color: var(--on-night-2);
  }
  .hero__in {
    grid-template-columns: minmax(0, 1fr);
  }
  .hero__globe {
    width: min(118vw, 560px);
    margin-inline: calc(50% - min(59vw, 280px));
    margin-bottom: max(-34vw, -180px);
  }
  .hero__globe {
    position: relative;
  }
  .orbit__chip {
    position: absolute;
    left: var(--x);
    top: var(--y);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px 8px 8px;
    border-radius: 999px;
    background: hsl(188 42% 10% / 0.72);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow:
      inset 0 0 0 1px hsl(166 58% 52% / 0.28),
      0 18px 36px -18px hsl(188 60% 3% / 0.9);
    color: var(--on-night);
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
    pointer-events: none;
    animation:
      chip-in 0.9s var(--ease) both,
      float 6s ease-in-out infinite alternate;
    animation-delay:
      calc(0.9s + var(--i) * 0.15s),
      calc(var(--i) * -1.3s);
  }
  .orbit__icon {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: hsl(166 58% 52% / 0.16);
    color: var(--teal-bright);
  }
  .orbit__chip:nth-child(2) .orbit__icon {
    background: hsl(38 85% 52% / 0.18);
    color: var(--amber);
  }
  @keyframes chip-in {
    from {
      opacity: 0;
      scale: 0.8;
    }
  }
  @keyframes float {
    from {
      translate: 0 -8px;
    }
    to {
      translate: 0 8px;
    }
  }
  @media (max-width: 999px) {
    .orbit {
      display: none;
    }
  }
  .marquee {
    position: relative;
    border-top: 1px solid var(--night-line);
    background: hsl(188 42% 7.5% / 0.7);
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee 48s linear infinite;
  }
  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }
  .marquee span {
    display: flex;
    align-items: center;
    padding: 18px 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1rem;
    color: var(--on-night-2);
    white-space: nowrap;
  }
  .marquee span::after {
    content: '';
    width: 6px;
    height: 6px;
    margin-inline: 28px;
    border-radius: 50%;
    background: var(--teal);
  }
  @media (min-width: 1000px) {
    .hero__in {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    }
    .hero h1 .line {
      white-space: nowrap;
    }
    .hero__globe {
      width: min(58vw, 780px, 84svh);
      margin: -6% -30% -6% -14%;
      justify-self: start;
    }
  }

  /* ---------- Intro ---------- */
  .intro__in {
    display: grid;
    gap: 40px 80px;
  }
  .intro__statement {
    font-size: clamp(1.75rem, 3.3vw, 2.875rem);
    line-height: 1.14;
    letter-spacing: -0.028em;
    font-weight: 500;
    max-width: 22ch;
    text-wrap: pretty;
  }
  .intro__statement span {
    color: var(--teal-deep);
  }
  .intro__side > p {
    color: var(--ink-2);
    font-size: 1.125rem;
    max-width: 52ch;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: 24px;
    margin: 32px 0 20px;
    border-top: 1px solid var(--line);
  }
  .facts div {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }
  .facts dt {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    min-width: 1.4ch;
    font-variant-numeric: tabular-nums;
  }
  .facts dd {
    color: var(--ink-2);
  }
  @media (min-width: 960px) {
    .intro__in {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  /* ---------- Pillars ---------- */
  .pillars {
    display: grid;
    gap: 14px;
  }
  .pillar {
    position: relative;
    border-radius: var(--r-lg);
    padding: clamp(24px, 3vw, 36px);
    overflow: hidden;
    transition: flex-grow 0.8s var(--ease);
  }
  .pillar--people {
    background: var(--amber-tint);
    --accent: var(--amber-deep);
  }
  .pillar--technology {
    background: var(--tech-tint);
    --accent: var(--teal-deep);
  }
  .pillar--ai {
    background: var(--night);
    color: var(--on-night);
    --accent: var(--teal-bright);
  }
  .pillar__label {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 14px;
  }
  .pillar h3 {
    font-size: clamp(1.5rem, 2.1vw, 1.875rem);
    letter-spacing: -0.024em;
    line-height: 1.12;
    max-width: 16ch;
  }
  .pillar__more {
    display: grid;
    gap: 28px;
    margin-top: 24px;
  }
  .pillar__text > p {
    max-width: 46ch;
    opacity: 0.82;
  }
  .pillar__text ul {
    display: grid;
    gap: 8px;
    margin: 20px 0 16px;
    font-weight: 500;
  }
  .pillar__text li {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .pillar__text li :global(svg) {
    color: var(--accent);
    flex: none;
  }
  .pillar .arrow-link {
    color: var(--accent);
  }
  .pillar__visual {
    align-self: end;
    font-size: 0.875rem;
  }
  .v-list {
    display: grid;
    gap: 8px;
  }
  .v-list li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 11px 14px;
    border-radius: 12px;
    background: var(--glass);
    box-shadow: var(--shadow-1);
    animation: row-nudge 6s var(--ease-io) infinite;
    animation-delay: calc(var(--n) * 1.5s);
  }
  .v-list b {
    display: block;
    font-weight: 600;
  }
  .v-list span {
    color: var(--ink-2);
  }
  .v-list b {
    color: var(--ink);
